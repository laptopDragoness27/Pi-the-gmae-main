pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--pigen code
--large number math functions from github user benstopics
-- add 2 numeric strings
function stringadd(a, b)
    return tostr(tonum(a .. "", 2) + tonum(b .. "", 2), 2)
end
-- subtract 2 numeric strings
function stringsub(a, b)
    return tostr(tonum(a .. "", 2) - tonum(b .. "", 2), 2)
end
-- multiply 2 numeric strings
function stringmul(a, b)
    return tostr(tonum(a .. "", 2) * (tonum(b .. "", 2) << 16), 2)
end
-- divide 2 numeric strings
function stringdiv(a, b)
    return tostr(tonum(a .. "", 2) / (tonum(b .. "", 2) << 16), 2)
end
-- modulo 2 numeric strings
function stringmod(a, b)
    return stringsub(a,stringmul(b,stringdiv(a, b)))
end

--floor divide
function flrdiv(a,b)
 unround=stringdiv(tostr(a),tostr(b))
 return flr(tonum(unround))
end

function gen1pidig(digits, pi)

 carry="0"
 for x=count(digits),1,-1 do
  --step 1
  digits[x]=stringmul(tostr(digits[x]),"10")
  --step 2
  if x!=1 then
   digits[x]=stringadd(tostr(digits[x]),tostr(carry))
   local q = flrdiv(digits[x], stringsub(stringmul("2",tostr(x)),"1"))
   carry =stringmul(tostr(q), stringsub(tostr(x),"1"))
   digits[x]=stringmod(tostr(digits[x]),tostr(stringsub(stringmul("2",tostr(x)),"1")))
  else
   digits[x]=stringadd(tostr(digits[x]),tostr(carry))
   local q = flrdiv(digits[x], "10")
   digits[x]=stringmod(tostr(digits[x]),"10")
   add(pi,tostr(q))
  end
  
  if x%175==0 then
  	yield()
  end
 end
 
 return digits,pi
end

-->8
--gamecode
function _init()
 cls(1)
 gamestate="start"
 pi={}
 digits={}
 p=nil
 --large enough for ~1000 digits
 for x=1,3334 do
  digits[x]="2"
 end
 digits, pi = gen1pidig(digits,pi)
 numberselected=1
 currentpidig=1
 score = 0
 highscore = 0
 timer = 5
 timerlen = 5
 counter=0
 playsound=true
 playloss=true
 staticstate=0
 playstatic=false
end
function _draw()
 cls(1)
 if gamestate=="start" then
  map(16,0)
  print("\^w\^tpi: the game!",15,55,7)
  print("press 🅾️ to start",30,74)
 elseif gamestate=="game" then
  map()
  rectfill(33,8,33+timer*15,13,8)
  print("⧗"..ceil(timer),20,8,7)
  spr(11,numberselected*8+16,96)
  print("score "..score,52,1,7)
  --prints previous digits
  if currentpidig>1 then
   print(pi[currentpidig-1], 46,75,7)
  end
  if currentpidig>2 then
   print(pi[currentpidig-2], 41,75,7)
  end
  if currentpidig>3 then
   print(pi[currentpidig-3], 36,75,7)
  end
  if currentpidig>4 then
   print(pi[currentpidig-4], 31,75,7)
  end
  if currentpidig>5 then
   print(pi[currentpidig-5], 26,75,7)
  end
  if currentpidig>6 then
   print(pi[currentpidig-6], 21,75,7)
  end
  if currentpidig>7 then
   print(pi[currentpidig-7], 16,75,7)
  end
  if currentpidig>8 then
   print(pi[currentpidig-8], 11,75,7)
  end
  if currentpidig>9 then
   print(pi[currentpidig-9], 6,75,7)
  end
  if currentpidig>10 then
   print(pi[currentpidig-10], 1,75,7)
  end
  print("?????????????",77,75,7)
 elseif gamestate=="lose" then
  print("\^w\^t\^=game over",27,43,8)
  print("press ❎ to play again",18,60)
  print("score: "..score,45,73,7)
  print("high score: "..highscore,35,83,10)
  if playloss then
   sfx(3)
   playloss=false
  end
  if score>highscore then
   highscore=score
  elseif btnp(❎) then
   --reset code
   numberselected=1
   currentpidig=1
   gamestate="game"
   score=0
   timer = 5
   timerlen=5
   playloss=true
  end
  
 elseif gamestate=="win" then
  print("\^w\^tyou're winner!",12,55,7)
  print("we ran out of digits", 26,71,7)
  print("you guessed them all",26, 80, 7)
  print("press 🅾️ to return", 30,112,7)
  print("to title screen",36,120,7)
  if playsound then
   sfx(0)
   playsound=false
  end
 end
end

function _update()
	if validation and costatus(validation) != "dead" then
		coresume(validation)
	end

 --if there's frame time continue p
 if p!=nil then
  if stat(1)>0.9 then
   coresume(p)
  end
  if stat(1)>=0.9 then
   yield(p)
   print(stat(1))
  end
 end
 --start game
 if gamestate=="start" then
  if btnp(🅾️) then
   gamestate="game"
  end
 elseif gamestate=="game" then
  counter+=1
  if counter==3 then
   counter = 0
   timer-=0.1
   if timer<=0 then
    gamestate="lose"
   end
  end
  
  if not validating then
	  if btnp(➡️) then
	   numberselected+=1
	   if numberselected>10 then
	    numberselected=1
	   end
	  elseif btnp(⬅️) then
	   numberselected-=1
	   if numberselected<1 then
	    numberselected=10
	   end
	  elseif btnp(🅾️) then
	   repeat
	    --create noise on screen
	    if playstatic then
	     sfx(4)
	    else
	     playstatic=true
	    end
	    if staticstate==0 then
	     map(0,16)
	     staticstate=1
	    else
	     map(16,16)
	     staticstate=0
	    end
	    if validation and costatus(validation) != "dead" then
		    coresume(validation)
    	end
	   until count(pi)>=currentpidig
	   playstatic=false
	   if tonum(pi[currentpidig])==numberselected-1 then
	    currentpidig+=1
	    score+=1
	    timer = timerlen
	    if currentpidig>1000 then
	     gamestate="win"
	    else
	     sfx(1)
	     if count(pi)<=currentpidig then
	      validate(digits,pi)
	     end
	    end
	   else
	    gamestate="lose"
	   end
	  end
	 end
 elseif gamestate=="lose" then
 elseif gamestate=="win" then
  if btnp(🅾️) then
   gamestate="start"
   digits, pi = gen1pidig(digits,pi)
   numberselected=1
   currentpidig=1
   score = 0
   timer = 5
   timerlen = 5
   counter=0
   playsound=true
   playloss=true
   staticstate=0
   playstatic=false
  end
 end
end

function validate(d,p)
	validation=cocreate(function()
		
		digits,pi = gen1pidig(digits,pi)
	
	 if currentpidig>count(pi) then
	  gamestate="win"
	 end
	 
	end)	
end
